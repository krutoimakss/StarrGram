+package org.telegram.starrgram;
+
+import android.text.TextUtils;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.MessageObject;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.R;
+import org.telegram.messenger.SendMessagesHelper;
+import org.telegram.messenger.UserConfig;
+import org.telegram.messenger.UserObject;
+import org.telegram.messenger.Utilities;
+import org.telegram.messenger.utils.tlutils.AmountUtils;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.tgnet.tl.TL_account;
+import org.telegram.tgnet.tl.TL_stars;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.Components.BulletinFactory;
+import org.telegram.ui.ProfileActivity;
+
+import java.util.ArrayList;
+import java.util.regex.Pattern;
+
+/**
+ * Logic of the Starrgram features. All hooks in the Telegram code are one-liners that call into this class.
+ */
+public class StarrFeatures {
+
+    /** Context menu option: show the author of a channel post. Must not clash with ChatActivity.OPTION_*. */
+    public static final int OPTION_AUTHOR = 9001;
+
+    // ------------------------------------------------------------------------------------------
+    // –ü–∏—Å–∞—Ç–µ–ª—å: text before every outgoing message
+    // ------------------------------------------------------------------------------------------
+
+    public static void applyWriter(SendMessagesHelper.SendMessageParams p) {
+        if (p == null || !StarrConfig.isEnabled(StarrConfig.WRITER)) {
+            return;
+        }
+        final String prefix = StarrConfig.getWriterText();
+        if (TextUtils.isEmpty(prefix) || TextUtils.isEmpty(p.message)) {
+            return;
+        }
+        // only plain text messages, no media, no polls, no retries of already sent messages
+        if (p.retryMessageObject != null || p.richMessage != null || p.photo != null || p.document != null ||
+            p.location != null || p.game != null || p.poll != null || p.todo != null || p.invoice != null || p.user != null) {
+            return;
+        }
+        // bot commands must stay commands
+        if (p.message.startsWith("/")) {
+            return;
+        }
+        // sendMessage can be re-entered (paid message confirmation): never add the text twice
+        if (p.message.startsWith(prefix + " ")) {
+            return;
+        }
+        final int shift = prefix.length() + 1;
+        if (p.entities != null) {
+            for (int i = 0; i < p.entities.size(); i++) {
+                p.entities.get(i).offset += shift;
+            }
+        }
+        p.message = prefix + " " + p.message;
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // –£–¥–∞–ª—è—Ç–µ–ª—å–†–µ–∫–ª–∞–º: ads from bots in private chats
+    // ------------------------------------------------------------------------------------------
+
+    private static final Pattern AD_PATTERN = Pattern.compile(
+        "(?iu)(?<![\\p{L}\\p{N}_])(—Ä–µ–∫–ª–∞–º[\\p{L}]*|erid|#ad|#advert[\\p{L}]*|sponsored|advertis[\\p{L}]*)(?![\\p{L}\\p{N}_])"
+    );
+
+    public static void maybeRemoveBotAd(int account, TLRPC.Message message) {
+        if (message == null || message.out || TextUtils.isEmpty(message.message) || !StarrConfig.isEnabled(StarrConfig.AD_REMOVER)) {
+            return;
+        }
+        final long dialogId = message.dialog_id;
+        if (dialogId <= 0 || message.id <= 0) {
+            return; // only private chats
+        }
+        final TLRPC.User user = MessagesController.getInstance(account).getUser(dialogId);
+        if (user == null || !user.bot || !AD_PATTERN.matcher(message.message).find()) {
+            return;
+        }
+        final int messageId = message.id;
+        // wait a little: the message has to be saved before it can be deleted
+        AndroidUtilities.runOnUIThread(() -> {
+            ArrayList<Integer> ids = new ArrayList<>();
+            ids.add(messageId);
+            // forAll = false: removes the message only from this account, always allowed
+            MessagesController.getInstance(account).deleteMessages(ids, null, null, dialogId, 0, false, 0);
+        }, 2500);
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // –í–∞–Ω–≥–∞: only tells that a message was deleted, never keeps its text
+    // ------------------------------------------------------------------------------------------
+
+    public static void onMessagesDeleted(BaseFragment fragment, ArrayList<MessageObject> deleted) {
+        if (fragment == null || deleted == null || deleted.isEmpty() || !StarrConfig.isEnabled(StarrConfig.WANGA)) {
+            return;
+        }
+        if (System.currentTimeMillis() - StarrConfig.lastLocalDeleteTime < 4000) {
+            return; // the user deleted it himself
+        }
+        int incoming = 0;
+        for (int i = 0; i < deleted.size(); i++) {
+            MessageObject m = deleted.get(i);
+            if (m != null && !m.isOutOwner() && m.getId() > 0) {
+                incoming++;
+            }
+        }
+        if (incoming == 0) {
+            return;
+        }
+        final String text = incoming == 1 ? "Starrgram: —Å–æ–æ–±—â–µ–Ω–∏–µ –±—ã–ª–æ —É–¥–∞–ª–µ–Ω–æ" : "Starrgram: —É–¥–∞–ª–µ–Ω–æ —Å–æ–æ–±—â–µ–Ω–∏–π: " + incoming;
+        toast(fragment, text);
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // –ö–∞–Ω–∞–ª–Æ–∑–µ—Ä: who wrote a channel post
+    // ------------------------------------------------------------------------------------------
+
+    public static void addAuthorOption(MessageObject msg, ArrayList<CharSequence> items, ArrayList<Integer> options, ArrayList<Integer> icons) {
+        if (msg == null || msg.messageOwner == null || !StarrConfig.isEnabled(StarrConfig.CHANNEL_USER)) {
+            return;
+        }
+        final TLRPC.Message m = msg.messageOwner;
+        if (!m.post) {
+            return;
+        }
+        if (TextUtils.isEmpty(m.post_author) && !(m.from_id instanceof TLRPC.TL_peerUser)) {
+            return;
+        }
+        items.add("–ê–≤—Ç–æ—Ä –ø–æ—Å—Ç–∞ (Starrgram)");
+        options.add(OPTION_AUTHOR);
+        icons.add(R.drawable.msg_openprofile);
+    }
+
+    public static void showPostAuthor(BaseFragment fragment, MessageObject msg) {
+        if (fragment == null || msg == null || msg.messageOwner == null) {
+            return;
+        }
+        final TLRPC.Message m = msg.messageOwner;
+        final int account = fragment.getCurrentAccount();
+        if (m.from_id instanceof TLRPC.TL_peerUser) {
+            // the channel shows author profiles: Telegram gave us the exact user
+            fragment.presentFragment(ProfileActivity.of(m.from_id.user_id));
+            return;
+        }
+        final String name = m.post_author == null ? "" : m.post_author.replace("\n", " ").trim();
+        if (name.isEmpty()) {
+            toast(fragment, "–£ —ç—Ç–æ–≥–æ –ø–æ—Å—Ç–∞ –Ω–µ—Ç –ø–æ–¥–ø–∏—Å–∏ –∞–≤—Ç–æ—Ä–∞");
+            return;
+        }
+        // Telegram gives only the signature text, so the best we can do is to look for people with this name
+        final TLRPC.TL_contacts_search req = new TLRPC.TL_contacts_search();
+        req.q = name;
+        req.limit = 10;
+        ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> AndroidUtilities.runOnUIThread(() -> {
+            if (fragment.getParentActivity() == null) {
+                return;
+            }
+            if (!(response instanceof TLRPC.TL_contacts_found)) {
+                toast(fragment, "–ù–µ —É–¥–∞–ª–æ—Å—å –Ω–∞–π—Ç–∏ –∞–≤—Ç–æ—Ä–∞");
+                return;
+            }
+            final TLRPC.TL_contacts_found found = (TLRPC.TL_contacts_found) response;
+            MessagesController.getInstance(account).putUsers(found.users, false);
+            final ArrayList<TLRPC.User> users = new ArrayList<>();
+            for (int i = 0; i < found.users.size(); i++) {
+                TLRPC.User u = found.users.get(i);
+                if (u != null && !u.bot) {
+                    users.add(u);
+                }
+            }
+            if (users.isEmpty()) {
+                toast(fragment, "–ê–≤—Ç–æ—Ä ¬´" + name + "¬ª –Ω–µ –Ω–∞–π–¥–µ–Ω");
+                return;
+            }
+            showUsersDialog(fragment, "–ê–≤—Ç–æ—Ä: ¬´" + name + "¬ª. –í–æ–∑–º–æ–∂–Ω—ã–µ –ø—Ä–æ—Ñ–∏–ª–∏", users);
+        }));
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // –í–æ–∑–º–æ–∂–Ω—ã–µ–î—Ä—É–∑—å—è: who of my contacts is subscribed to a channel
+    // ------------------------------------------------------------------------------------------
+
+    public static void showContactSubscribers(BaseFragment fragment, long chatId) {
+        if (fragment == null) {
+            return;
+        }
+        final int account = fragment.getCurrentAccount();
+        final TLRPC.TL_channels_getParticipants req = new TLRPC.TL_channels_getParticipants();
+        req.channel = MessagesController.getInstance(account).getInputChannel(chatId);
+        final TLRPC.TL_channelParticipantsContacts filter = new TLRPC.TL_channelParticipantsContacts();
+        filter.q = "";
+        req.filter = filter;
+        req.offset = 0;
+        req.limit = 100;
+        req.hash = 0;
+        ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> AndroidUtilities.runOnUIThread(() -> {
+            if (fragment.getParentActivity() == null) {
+                return;
+            }
+            if (!(response instanceof TLRPC.TL_channels_channelParticipants)) {
+                toast(fragment, "Telegram –Ω–µ –æ—Ç–¥–∞—ë—Ç —Å–ø–∏—Å–æ–∫ –ø–æ–¥–ø–∏—Å—á–∏–∫–æ–≤ —ç—Ç–æ–≥–æ –∫–∞–Ω–∞–ª–∞");
+                return;
+            }
+            final TLRPC.TL_channels_channelParticipants res = (TLRPC.TL_channels_channelParticipants) response;
+            MessagesController.getInstance(account).putUsers(res.users, false);
+            final long selfId = UserConfig.getInstance(account).getClientUserId();
+            final ArrayList<TLRPC.User> users = new ArrayList<>();
+            for (int i = 0; i < res.users.size(); i++) {
+                TLRPC.User u = res.users.get(i);
+                if (u != null && u.id != selfId) {
+                    users.add(u);
+                }
+            }
+            if (users.isEmpty()) {
+                toast(fragment, "–ò–∑ –≤–∞—à–∏—Ö –∫–æ–Ω—Ç–∞–∫—Ç–æ–≤ –∑–¥–µ—Å—å –Ω–∏–∫–æ–≥–æ –Ω–µ—Ç");
+                return;
+            }
+            showUsersDialog(fragment, "–ü–æ–¥–ø–∏—Å–∞–Ω—ã –∏–∑ –∫–æ–Ω—Ç–∞–∫—Ç–æ–≤: " + users.size(), users);
+        }));
+    }
+
+    private static void showUsersDialog(BaseFragment fragment, String title, ArrayList<TLRPC.User> users) {
+        final CharSequence[] names = new CharSequence[users.size()];
+        for (int i = 0; i < users.size(); i++) {
+            final TLRPC.User u = users.get(i);
+            final String username = UserObject.getPublicUsername(u);
+            names[i] = UserObject.getUserName(u) + (TextUtils.isEmpty(username) ? "" : "  @" + username);
+        }
+        final AlertDialog.Builder builder = new AlertDialog.Builder(fragment.getParentActivity());
+        builder.setTitle(title);
+        builder.setItems(names, (dialog, which) -> {
+            if (which >= 0 && which < users.size()) {
+                fragment.presentFragment(ProfileActivity.of(users.get(which).id));
+            }
+        });
+        builder.setNegativeButton("–ó–∞–∫—Ä—ã—Ç—å", null);
+        fragment.showDialog(builder.create());
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // –ù—Ñ—Ç–ó–∞–∫—É–ø—â–∏–∫: cheapest listing of the same NFT collection, in stars and TON
+    // ------------------------------------------------------------------------------------------
+
+    public static void loadNftFloor(int account, TL_stars.StarGift gift, Utilities.Callback<CharSequence> done) {
+        if (gift == null || gift.gift_id == 0) {
+            done.run("–Ω–µ—Ç –¥–∞–Ω–Ω—ã—Ö");
+            return;
+        }
+        final TL_stars.getResaleStarGifts req = new TL_stars.getResaleStarGifts();
+        req.gift_id = gift.gift_id;
+        req.offset = "";
+        req.limit = 1;
+        req.sort_by_price = true;
+        req.flags |= 1; // attributes_hash is present: 0 = no attribute filter
+        req.attributes_hash = 0;
+        ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> AndroidUtilities.runOnUIThread(() -> {
+            if (!(response instanceof TL_stars.resaleStarGifts)) {
+                done.run("–Ω–µ —É–¥–∞–ª–æ—Å—å —É–∑–Ω–∞—Ç—å");
+                return;
+            }
+            final TL_stars.resaleStarGifts res = (TL_stars.resaleStarGifts) response;
+            if (res.gifts == null || res.gifts.isEmpty()) {
+                done.run("–Ω–µ—Ç –≤ –ø—Ä–æ–¥–∞–∂–µ");
+                return;
+            }
+            final TL_stars.StarGift cheapest = res.gifts.get(0);
+            final AmountUtils.Amount stars = cheapest.getResellAmount(AmountUtils.Currency.STARS);
+            final AmountUtils.Amount ton = cheapest.getResellAmount(AmountUtils.Currency.TON);
+            final StringBuilder sb = new StringBuilder();
+            if (stars != null && stars.asNano() > 0) {
+                sb.append("–æ—Ç ").append(stars.asFormatString()).append(" ‚≠ê");
+            }
+            if (ton != null && ton.asNano() > 0) {
+                sb.append(sb.length() > 0 ? " ¬∑ " : "–æ—Ç ").append(ton.asFormatString()).append(" TON");
+            }
+            if (sb.length() == 0) {
+                sb.append("–Ω–µ—Ç –≤ –ø—Ä–æ–¥–∞–∂–µ");
+            } else if (res.count > 0) {
+                sb.append(" (–≤ –ø—Ä–æ–¥–∞–∂–µ: ").append(res.count).append(")");
+            }
+            done.run(sb.toString());
+        }));
+    }
+
+    // ------------------------------------------------------------------------------------------
+    // –ó–≤–µ–∑–¥–Ω—ã–µ–ì–ª–∞–∑–∞: put / remove our marker in the bio
+    // ------------------------------------------------------------------------------------------
+
+    public static void setBioMarker(BaseFragment fragment, boolean on, Utilities.Callback<Boolean> done) {
+        final int account = fragment.getCurrentAccount();
+        final TLRPC.User self = UserConfig.getInstance(account).getCurrentUser();
+        if (self == null) {
+            done.run(false);
+            return;
+        }
+        MessagesController.getInstance(account).loadFullUser(self, fragment.getClassGuid(), true, full -> {
+            if (full == null) {
+                AndroidUtilities.runOnUIThread(() -> done.run(false));
+                return;
+            }
+            String about = full.about == null ? "" : full.about;
+            String newAbout = about.replace(StarrConfig.BIO_MARKER, "").trim();
+            if (on) {
+                newAbout = newAbout.isEmpty() ? StarrConfig.BIO_MARKER : newAbout + " " + StarrConfig.BIO_MARKER;
+            }
+            if (newAbout.equals(about)) {
+                AndroidUtilities.runOnUIThread(() -> done.run(true));
+                return;
+            }
+            if (newAbout.length() > MessagesController.getInstance(account).getAboutLimit()) {
+                AndroidUtilities.runOnUIThread(() -> {
+                    toast(fragment, "–í –æ–ø–∏—Å–∞–Ω–∏–∏ –ø—Ä–æ—Ñ–∏–ª—è –Ω–µ —Ö–≤–∞—Ç–∞–µ—Ç –º–µ—Å—Ç–∞ –¥–ª—è –º–µ—Ç–∫–∏. –°–æ–∫—Ä–∞—Ç–∏—Ç–µ –µ–≥–æ.");
+                    done.run(false);
+                });
+                return;
+            }
+            final String finalAbout = newAbout;
+            final TL_account.updateProfile req = new TL_account.updateProfile();
+            req.flags |= 4;
+            req.about = finalAbout;
+            ConnectionsManager.getInstance(account).sendRequest(req, (response, error) -> AndroidUtilities.runOnUIThread(() -> {
+                if (error == null) {
+                    full.about = finalAbout;
+                    done.run(true);
+                } else {
+                    toast(fragment, "–ù–µ —É–¥–∞–ª–æ—Å—å –∏–∑–º–µ–Ω–∏—Ç—å –æ–ø–∏—Å–∞–Ω–∏–µ –ø—Ä–æ—Ñ–∏–ª—è");
+                    done.run(false);
+                }
+            }));
+        });
+    }
+
+    // ------------------------------------------------------------------------------------------
+
+    public static void toast(BaseFragment fragment, String text) {
+        try {
+            BulletinFactory.of(fragment).createSimpleBulletin(R.raw.info, text).show();
+        } catch (Throwable ignore) {
+        }
+    }
+}
