+package org.telegram.starrgram;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.UserConfig;
+
+import java.util.HashSet;
+import java.util.Set;
+
+/**
+ * Starrgram settings storage. Everything lives in one SharedPreferences file ("starrgram").
+ */
+public class StarrConfig {
+
+    // feature keys
+    public static final String GHOST = "ghost";               // –ü—Ä–∏–∑—Ä–∞–∫
+    public static final String STAR_EYES = "star_eyes";       // –ó–≤–µ–∑–¥–Ω—ã–µ–ì–ª–∞–∑–∞
+    public static final String BIO_MARK = "bio_mark";         // –ø—É–±–ª–∏–∫–æ–≤–∞—Ç—å —Å–≤–æ—é –º–µ—Ç–∫—É –≤ –±–∏–æ
+    public static final String NFT = "nft";                   // –ù—Ñ—Ç–ó–∞–∫—É–ø—â–∏–∫
+    public static final String CHANNEL_USER = "channel_user"; // –ö–∞–Ω–∞–ª–Æ–∑–µ—Ä
+    public static final String AD_REMOVER = "ad_remover";     // –£–¥–∞–ª—è—Ç–µ–ª—å–†–µ–∫–ª–∞–º
+    public static final String WRITER = "writer";             // –ü–∏—Å–∞—Ç–µ–ª—å
+    public static final String FRIENDS = "friends";           // –í–æ–∑–º–æ–∂–Ω—ã–µ–î—Ä—É–∑—å—è
+    public static final String WANGA = "wanga";               // –í–∞–Ω–≥–∞ (—Ç–æ–ª—å–∫–æ –ø–æ–º–µ—Ç–∫–∞, –±–µ–∑ —Ç–µ–∫—Å—Ç–∞)
+
+    /** The marker other Starrgram users look for at the end of a bio. */
+    public static final String BIO_MARKER = "‚≠êStarrgram";
+    /** Appended to a name when the person uses Starrgram. */
+    public static final String NAME_STAR = " ‚≠ê";
+
+    private static final String PREFS = "starrgram";
+    private static final String KEY_WRITER_TEXT = "writer_text";
+    private static final String KEY_STARR_USERS = "starr_users";
+    private static final int MAX_KNOWN_USERS = 5000;
+
+    /** Time of the last deletion started by the user himself (to not show "deleted" notices for it). */
+    public static volatile long lastLocalDeleteTime;
+
+    private static volatile boolean loaded;
+    private static volatile boolean starEyesEnabled;
+    private static volatile boolean bioMarkEnabled;
+    private static final Set<Long> starrUsers = new HashSet<>();
+
+    private static SharedPreferences prefs() {
+        Context context = ApplicationLoader.applicationContext;
+        if (context == null) {
+            return null;
+        }
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    private static void ensureLoaded() {
+        if (loaded) {
+            return;
+        }
+        SharedPreferences p = prefs();
+        if (p == null) {
+            return;
+        }
+        synchronized (starrUsers) {
+            if (loaded) {
+                return;
+            }
+            starEyesEnabled = p.getBoolean(STAR_EYES, false);
+            bioMarkEnabled = p.getBoolean(BIO_MARK, false);
+            Set<String> saved = p.getStringSet(KEY_STARR_USERS, null);
+            if (saved != null) {
+                for (String s : saved) {
+                    try {
+                        starrUsers.add(Long.parseLong(s));
+                    } catch (NumberFormatException ignore) {
+                    }
+                }
+            }
+            loaded = true;
+        }
+    }
+
+    public static boolean isEnabled(String key) {
+        SharedPreferences p = prefs();
+        return p != null && p.getBoolean(key, false);
+    }
+
+    public static void setEnabled(String key, boolean value) {
+        SharedPreferences p = prefs();
+        if (p == null) {
+            return;
+        }
+        p.edit().putBoolean(key, value).apply();
+        if (STAR_EYES.equals(key)) {
+            starEyesEnabled = value;
+        } else if (BIO_MARK.equals(key)) {
+            bioMarkEnabled = value;
+        }
+    }
+
+    public static String getWriterText() {
+        SharedPreferences p = prefs();
+        return p == null ? "" : p.getString(KEY_WRITER_TEXT, "");
+    }
+
+    public static void setWriterText(String text) {
+        SharedPreferences p = prefs();
+        if (p != null) {
+            p.edit().putString(KEY_WRITER_TEXT, text == null ? "" : text).apply();
+        }
+    }
+
+    public static boolean ghostMode() {
+        return isEnabled(GHOST);
+    }
+
+    /** Hot path: called when a user name is drawn. */
+    public static boolean isStarrUser(long userId) {
+        ensureLoaded();
+        if (!starEyesEnabled) {
+            return false;
+        }
+        if (bioMarkEnabled && userId == UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId()) {
+            return true;
+        }
+        synchronized (starrUsers) {
+            return starrUsers.contains(userId);
+        }
+    }
+
+    /**
+     * Called every time full info of a user is loaded.
+     *
+     * @return true if the "uses Starrgram" state of the user changed
+     */
+    public static boolean onUserFull(long userId, String about) {
+        ensureLoaded();
+        boolean starr = about != null && about.contains(BIO_MARKER);
+        boolean changed;
+        Set<String> toSave = null;
+        synchronized (starrUsers) {
+            if (starr) {
+                changed = starrUsers.size() < MAX_KNOWN_USERS && starrUsers.add(userId);
+            } else {
+                changed = starrUsers.remove(userId);
+            }
+            if (changed) {
+                toSave = new HashSet<>();
+                for (Long id : starrUsers) {
+                    toSave.add(Long.toString(id));
+                }
+            }
+        }
+        if (toSave != null) {
+            SharedPreferences p = prefs();
+            if (p != null) {
+                p.edit().putStringSet(KEY_STARR_USERS, toSave).apply();
+            }
+        }
+        return changed && starEyesEnabled;
+    }
+
+    /** Adds the star to a display name when the person uses Starrgram. */
+    public static String decorateName(long userId, String name) {
+        if (name != null && isStarrUser(userId)) {
+            return name + NAME_STAR;
+        }
+        return name;
+    }
+}
